// Supervised RIGHT corner diagnostic, NOT a competition route.
// Sensor 3: robot-left; sensor 4: robot-right. C: left drive; A: right.
// Start on the previously tested straight with both sensors on black.
// First loss of black at BOTH sensors triggers one bounded forward pivot.
// Reacquiring black is NOT proof of 90 degrees or track containment.
// No reverse, sound, display, boolean AND/OR, or automatic retry.
#define BLACK_THRESHOLD 25
#define WHITE_THRESHOLD 75
#define CONTROL_INTERVAL_MS 20
#define APPROACH_STEPS 400
// Single bounded extension experiment after zero black contact in 60 samples.
// 90 samples is NOT a 90-degree measurement. Do not extend repeatedly.
#define TURN_STEPS 90
#define TURN_POWER 15
#define CONFIRM_SAMPLES 3

task main()
{
    unsigned int leftReading = 0;
    unsigned int rightReading = 0;
    int approachStep;
    int turnStep = 0;
    int stable = 0;
    int phase = 0; // 0: approach, 1: right pivot.
    int turnSamples = 0;
    int leftBlackSamples = 0;
    int rightBlackSamples = 0;
    int bothBlackSamples = 0;
    // Sample positions are ONE-based; zero means never observed.
    int firstLeftBlack = 0;
    int lastLeftBlack = 0;
    int firstRightBlack = 0;
    int lastRightBlack = 0;
    int stopReason = 3; // 1: white, 3: approach limit, 4: turn limit,
                        // 5: both-black confirmation (geometry unverified).

    Off(OUT_AC);
    SetSensorLight(IN_3);
    SetSensorLight(IN_4);
    Wait(1500);

    for (approachStep = 0; approachStep < APPROACH_STEPS; approachStep++)
    {
        leftReading = Sensor(IN_3);
        rightReading = Sensor(IN_4);
        if (leftReading > WHITE_THRESHOLD)
        {
            stopReason = 1;
            break;
        }
        if (rightReading > WHITE_THRESHOLD)
        {
            stopReason = 1;
            break;
        }
        if (leftReading < BLACK_THRESHOLD)
        {
            if (rightReading < BLACK_THRESHOLD)
            {
                OnFwd(OUT_AC, 20);
            }
            else
            {
                OnFwd(OUT_C, 10);
                OnFwd(OUT_A, 25);
            }
        }
        else
        {
            if (rightReading < BLACK_THRESHOLD)
            {
                OnFwd(OUT_C, 25);
                OnFwd(OUT_A, 10);
            }
            else
            {
                phase = 1;
                break;
            }
        }
        Wait(CONTROL_INTERVAL_MS);
    }

    Off(OUT_AC);
    if (phase == 1)
    {
        stopReason = 4;
        for (turnStep = 0; turnStep < TURN_STEPS; turnStep++)
        {
            // Right drive stopped; only left drive advances. No reverse.
            Off(OUT_A);
            if (stable == 0)
            {
                OnFwd(OUT_C, TURN_POWER);
            }
            else
            {
                Off(OUT_AC);
            }
            Wait(CONTROL_INTERVAL_MS);
            leftReading = Sensor(IN_3);
            rightReading = Sensor(IN_4);
            // Accumulate only; emit telemetry AFTER stopping the motors.
            turnSamples++;
            if (leftReading < BLACK_THRESHOLD)
            {
                leftBlackSamples++;
                if (firstLeftBlack == 0)
                {
                    firstLeftBlack = turnSamples;
                }
                lastLeftBlack = turnSamples;
                if (rightReading < BLACK_THRESHOLD)
                {
                    bothBlackSamples++;
                }
            }
            if (rightReading < BLACK_THRESHOLD)
            {
                rightBlackSamples++;
                if (firstRightBlack == 0)
                {
                    firstRightBlack = turnSamples;
                }
                lastRightBlack = turnSamples;
            }
            if (leftReading > WHITE_THRESHOLD)
            {
                stopReason = 1;
                break;
            }
            if (rightReading > WHITE_THRESHOLD)
            {
                stopReason = 1;
                break;
            }
            if (leftReading < BLACK_THRESHOLD)
            {
                if (rightReading < BLACK_THRESHOLD)
                {
                    // Stop during confirmation, do not pivot past detection.
                    Off(OUT_AC);
                    stable++;
                }
                else
                {
                    stable = 0;
                }
            }
            else
            {
                stable = 0;
            }
            if (stable >= CONFIRM_SAMPLES)
            {
                stopReason = 5;
                break;
            }
        }
    }
    Off(OUT_AC);
    // Versioned frame: 37, 85, reason, phase, approach index, turn index,
    // left reading, right reading, consecutive both-black samples.
    // Then: turn samples, left-black count, right-black count, both-black
    // count, first-left, last-left, first-right, last-right, configured limit.
    // Approach/turn indices are zero-based, not elapsed time. Black sample
    // positions are one-based (zero: never). Port 1 must remain unused.
    // Counts include stationary confirmation samples; not motion duration.
    SetInput(IN_1, ScaledValue, 37);
    SetInput(IN_1, ScaledValue, 85);
    SetInput(IN_1, ScaledValue, stopReason);
    SetInput(IN_1, ScaledValue, phase);
    SetInput(IN_1, ScaledValue, approachStep);
    SetInput(IN_1, ScaledValue, turnStep);
    SetInput(IN_1, ScaledValue, leftReading);
    SetInput(IN_1, ScaledValue, rightReading);
    SetInput(IN_1, ScaledValue, stable);
    SetInput(IN_1, ScaledValue, turnSamples);
    SetInput(IN_1, ScaledValue, leftBlackSamples);
    SetInput(IN_1, ScaledValue, rightBlackSamples);
    SetInput(IN_1, ScaledValue, bothBlackSamples);
    SetInput(IN_1, ScaledValue, firstLeftBlack);
    SetInput(IN_1, ScaledValue, lastLeftBlack);
    SetInput(IN_1, ScaledValue, firstRightBlack);
    SetInput(IN_1, ScaledValue, lastRightBlack);
    SetInput(IN_1, ScaledValue, TURN_STEPS);
    while (true)
    {
        Off(OUT_AC);
        Wait(100);
    }
}
